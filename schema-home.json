    {
      "@type": "FAQPage",
      "@id": "https://www.oscarlogoteta.it/#faq-schema",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Chi è Oscar Logoteta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oscar Logoteta è un CIO e capo operations milanese, nato il 13 aprile 1983. Guida trasformazione digitale, costruisce prodotti con l'AI, e scrive noir ambientati a Milano. È founder di mitcamper e autore della saga del commissario Renato Negri."
          }
        },
        {
          "@type": "Question",
          "name": "Cosa fa Oscar Logoteta come CIO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unisce tecnologia, prodotto, persone e conti: AI e automazioni con Cursor, operations e riduzione costi misurabile (fino al -45% dove processi e AI contano), HR e cultura, app costruite end-to-end."
          }
        },
        {
          "@type": "Question",
          "name": "Quali libri ha scritto Oscar Logoteta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A come Armatura (2014, La Memoria del Mondo); la saga del commissario Negri per Fratelli Frilli — Milano disillusa (2017), Milano sottozero (2018), Milano vertigo (2021); e il racconto Strano, il destino in Quattro volte Natale (Todaro, 2020)."
          }
        },
        {
          "@type": "Question",
          "name": "Cos'è mitcamper?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "mitcamper è la piattaforma fondata e costruita da Oscar Logoteta da solo, end-to-end. Sito: https://www.mitcamper.com"
          }
        },
        {
          "@type": "Question",
          "name": "Dove si trova Oscar Logoteta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Milano, Italia. Contatto: oscarlogoteta@gmail.com e LinkedIn https://www.linkedin.com/in/oscarlogoteta"
          }
        }
      ]
